abi <abi/4.0>,
include <tunables/global>

# Ubuntu restricts user namespace creation by default. Firefox uses one for
# its content sandbox. The console UID's network boundary is enforced by nftables.
profile inkling2-console-browser /opt/inkling2-web/firefox/{firefox,firefox-bin} flags=(unconfined) {
  userns,
}

profile inkling2-tor-browser /var/lib/inkling2/tor-state/tor-browser/Browser/{firefox,firefox.real} flags=(unconfined) {
  userns,
}
