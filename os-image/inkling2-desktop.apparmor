abi <abi/4.0>,
include <tunables/global>

# WebKit uses a user namespace for the content process on Ubuntu.
profile inkling2-epiphany /usr/bin/{epiphany,epiphany-browser} flags=(unconfined) {
  userns,
}

profile inkling2-tor-browser /var/lib/inkling2/tor-state/tor-browser/Browser/{firefox,firefox.real} flags=(unconfined) {
  userns,
}
