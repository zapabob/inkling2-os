# Inkling2-OS Linux 6.12+ Kernel Configuration Fragment
# Target Hardware: AMD Ryzen 6C/12T (Zen 2+) + 32 GiB RAM + RTX 5060 Ti 16GB (sm_120a) + NVMe
# Goal: Zero WDDM, zero desktop compositor, maximum GDDR7 VRAM + 2MB HugePages + io_uring NVMe throughput

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_AMD=y

# Preemption & Real-Time Low-Latency Scheduling (cores 2-11 isolated for inference)
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_HIGH_RES_TIMERS=y

# HugePages (2 MiB & 1 GiB) for Zero-TLB-Miss Pinned RAM Expert Tier (SQ-15 / SQ-20)
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=n

# Direct NVMe + io_uring Zero-Copy Streaming
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_IO_URING=y
CONFIG_DIRECT_IO=y
CONFIG_EXT4_FS=y
CONFIG_NTFS3_FS=y
CONFIG_VFAT_FS=y

# PCIe Gen4/Gen5 & NVIDIA Open Kernel Module Requirements
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_DRM=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Networking: Ethernet + Wi-Fi + IPv4/IPv6 + nftables Stateful Firewall + TLS Crypto
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_VIRTIO_NET=m
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_RTW89=m
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y

# Audio (ALSA) & Webcam (V4L2 UVC) for Voice/Video Calls in Inkling2-OS
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=m

# Strip Unused Bluetooth/Printer Bloat
CONFIG_BT=n
CONFIG_USB_PRINTER=n
