rounded = 0
border_width = 0
background_color = #23383f 100

panel_items = EFEC
panel_position = top center horizontal
panel_size = 100% 36
panel_padding = 16 0 16
panel_background_id = 1
panel_layer = top
strut_policy = follow_size

time1_format = %H:%M
time1_font = DejaVu Sans Bold 10
clock_font_color = #edf5f4 100
clock_padding = 12 0
clock_tooltip = %Y-%m-%d

execp = new
execp_command = printf 'Inkling2\n'
execp_interval = 0
execp_font = DejaVu Sans Bold 11
execp_font_color = #edf5f4 100

execp = new
execp_command = /usr/bin/inkling2-desktop-status
execp_interval = 10
execp_font = DejaVu Sans 10
execp_font_color = #d4e8e9 100
execp_tooltip = Local engine and network route
