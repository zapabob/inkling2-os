# syntax=docker/dockerfile:1
ARG RUST_IMAGE=rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

FROM ${RUST_IMAGE} AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY ui/ ui/
COPY python/ python/
RUN cargo test --locked --workspace -j 2 && cargo build --locked --release --workspace -j 2 \
    && strip target/release/inkling2-init target/release/inkling2-shell

FROM ${UBUNTU_IMAGE} AS appliance
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iproute2 kmod nftables mount util-linux \
    dhcpcd-base wpasupplicant chrony \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-build /src/target/release/inkling2-init /sbin/inkling2-init
COPY --from=rust-build /src/target/release/inkling2-shell /usr/bin/inkling2-shell
COPY os-image/net/nftables.conf /etc/inkling2/nftables.conf
RUN groupadd --gid 61000 inkling2 && useradd --uid 61000 --gid 61000 \
    --no-create-home --shell /usr/sbin/nologin inkling2 \
    && mkdir -p /models /dev/pts /dev/shm /dev/hugepages \
    && ldd /sbin/inkling2-init && ldd /usr/bin/inkling2-shell

FROM ${UBUNTU_IMAGE} AS image
ENV DEBIAN_FRONTEND=noninteractive
ARG KERNEL_PACKAGE=linux-image-6.8.0-151-generic
RUN apt-get update && apt-get install -y --no-install-recommends \
    casper initramfs-tools "$KERNEL_PACKAGE" \
    grub-common grub-pc-bin grub-efi-amd64-bin xorriso mtools squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=appliance / /rootfs/
COPY os-image/grub/grub.cfg /iso/boot/grub/grub.cfg
RUN set -eu; mkdir -p /out /iso/casper; \
    kernel=$(find /boot -maxdepth 1 -type f -name 'vmlinuz-*' | sort -V | tail -1); \
    test -n "$kernel"; version=$(basename "$kernel" | cut -c9-); \
    printf 'RESUME=none\n' > /etc/initramfs-tools/conf.d/inkling2-resume; \
    rm -f "/boot/initrd.img-$version"; \
    update-initramfs -c -k "$version"; \
    lsinitramfs "/boot/initrd.img-$version" | awk '$0=="scripts/casper" {found=1} END {exit !found}'; \
    cp "$kernel" /iso/boot/vmlinuz; \
    cp "/boot/initrd.img-$version" /iso/boot/initramfs.img; \
    mkdir -p /rootfs/lib/modules; cp -a "/lib/modules/$version" /rootfs/lib/modules/; \
    mksquashfs /rootfs /iso/casper/filesystem.squashfs -comp zstd -noappend -processors 2; \
    grub-mkrescue -o /out/inkling2-os-v0.1.1-x86_64-sm120.iso /iso; \
    xorriso -indev /out/inkling2-os-v0.1.1-x86_64-sm120.iso -report_el_torito plain; \
    dpkg-query --admindir=/rootfs/var/lib/dpkg -W -f='${Package}\t${Version}\n' > /out/linux-rootfs-packages.tsv; \
    dpkg-query -W -f='${Package}\t${Version}\n' "$KERNEL_PACKAGE" "linux-modules-$version" >> /out/linux-rootfs-packages.tsv

FROM ${UBUNTU_IMAGE} AS verification
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ovmf qemu-system-x86 python3 && rm -rf /var/lib/apt/lists/*
COPY --from=image /out/ /out/
COPY os-image/verify-boot.py /usr/local/bin/verify-boot
ENTRYPOINT ["python3", "/usr/local/bin/verify-boot"]

FROM scratch AS artifact
COPY --from=image /out/ /
